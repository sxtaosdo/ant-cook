    "version": "3.8.8"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "editor:board": "node scripts/board-editor/serve.mjs",
    "editor:typecheck": "tsc -p scripts/board-editor/tsconfig.json --noEmit && tsc -p scripts/board-editor/tsconfig.level.json",
    "editor:test": "node --import tsx --test tests/editor/*.test.ts",
    "editor:levels": "node --import tsx scripts/board-editor/compile-level.ts",
    "editor:csv": "node --import tsx scripts/compileThemeCsv.mjs --check",
    "verify:editor": "pnpm run editor:typecheck && pnpm run editor:test && pnpm run editor:csv",
    "typecheck": "tsc -p tests/tsconfig.creator.json",
    "test": "node --loader ./tests/ts-loader.mjs --test tests/unit/*.test.ts tests/provider/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "22.18.3",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  },
  "MKFramework": {
    "version": "v1.1.5"
  }
}
